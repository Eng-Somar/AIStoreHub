# MongoDB Connection String (optional - app works without MongoDB using static data)
MONGODB_URI=mongodb://localhost:27017/aitoday

# Or use MongoDB Atlas for production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aitoday?retryWrites=true&w=majority

# Google Gemini API Key (required for update agent)
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Product Hunt API (optional - for enhanced data)
# Get your API key from: https://api.producthunt.com/v2/docs
PRODUCT_HUNT_API_KEY=your_product_hunt_api_key_here
PRODUCT_HUNT_API_SECRET=your_product_hunt_api_secret_here

# Update Agent Configuration
UPDATE_AGENT_MODE=incremental
UPDATE_AGENT_SCHEDULE=0 2 * * *
UPDATE_AGENT_AUTO_RUN=false
